{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/corpus/schemas/track-a-knowledge-release.schema.json",
  "title": "Track A Educational Design Knowledge Release",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_release_id",
    "created_at",
    "source",
    "construction",
    "counts",
    "files",
    "model_facing_sha256",
    "limitations",
    "model_facing"
  ],
  "properties": {
    "schema_version": { "const": "track-a-knowledge-release/v1" },
    "knowledge_release_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": [
        "source_snapshot_id",
        "source_design_card_count",
        "source_cards_sha256",
        "human_double_coding_complete"
      ],
      "properties": {
        "source_snapshot_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "source_design_card_count": { "type": "integer", "minimum": 1 },
        "source_cards_sha256": { "$ref": "#/$defs/sha256" },
        "human_double_coding_complete": { "const": false }
      },
      "additionalProperties": false
    },
    "construction": {
      "type": "object",
      "required": ["builder_version", "minimum_pattern_support", "pattern_dimensions"],
      "properties": {
        "builder_version": { "const": "track-a-educational-design-knowledge-builder/v1" },
        "minimum_pattern_support": { "const": 2 },
        "pattern_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["domain_synthesis", "cross_case_patterns", "design_cards", "total"],
      "properties": {
        "domain_synthesis": { "const": 6 },
        "cross_case_patterns": { "type": "integer", "minimum": 1 },
        "design_cards": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 8 }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": ["domain_synthesis", "cross_case_patterns", "design_cards"],
      "properties": {
        "domain_synthesis": { "$ref": "#/$defs/fileRecord" },
        "cross_case_patterns": { "$ref": "#/$defs/fileRecord" },
        "design_cards": { "$ref": "#/$defs/fileRecord" }
      },
      "additionalProperties": false
    },
    "model_facing_sha256": { "$ref": "#/$defs/sha256" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "model_facing": { "const": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileRecord": {
      "type": "object",
      "required": ["path", "count", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.ndjson$" },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
