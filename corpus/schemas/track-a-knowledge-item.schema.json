{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/corpus/schemas/track-a-knowledge-item.schema.json",
  "title": "Track A Educational Design Knowledge Item",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_id",
    "knowledge_type",
    "source_release_id",
    "source_ids",
    "evidence_status",
    "limitations",
    "retrieval_text",
    "model_facing"
  ],
  "properties": {
    "schema_version": { "const": "track-a-knowledge-item/v1" },
    "knowledge_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "knowledge_type": {
      "enum": ["domain_synthesis", "cross_case_pattern", "case_design_card"]
    },
    "source_release_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "annotation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "evidence_status": {
      "enum": ["development_exploratory", "creator_described_automation_reviewed"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "retrieval_text": { "type": "string", "minLength": 1 },
    "model_facing": { "const": true },

    "dimension": {
      "enum": [
        "educational_purpose",
        "intended_audience",
        "application_setting",
        "interactive_narrative_form",
        "if_mechanics",
        "interaction_education_relationship"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "total_n": { "type": "integer", "minimum": 1 },
    "eligible_n": { "type": "integer", "minimum": 0 },
    "not_stated_n": { "type": "integer", "minimum": 0 },
    "uncertain_n": { "type": "integer", "minimum": 0 },
    "label_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "support_n"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "support_n": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "status_counts": {
      "type": "object",
      "required": ["explicit", "normalized", "not_stated", "uncertain"],
      "properties": {
        "explicit": { "type": "integer", "minimum": 0 },
        "normalized": { "type": "integer", "minimum": 0 },
        "not_stated": { "type": "integer", "minimum": 0 },
        "uncertain": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "related_pattern_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "related_design_card_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },

    "pattern_kind": {
      "enum": ["single_label_frequency", "two_field_cooccurrence"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "educational_purpose",
          "intended_audience",
          "application_setting",
          "interactive_narrative_form",
          "if_mechanics",
          "interaction_education_relationship"
        ]
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["dimension", "label"],
        "properties": {
          "dimension": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "support_n": { "type": "integer", "minimum": 2 },
    "supporting_case_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "calculation_rule": { "type": "string", "minLength": 1 },
    "pattern_summary": { "type": "string", "minLength": 1 },

    "quality_tier": { "enum": ["A", "B", "C"] },
    "coverage_profile": { "enum": ["complete_core", "partial_substantive"] },
    "educational_purpose": { "$ref": "#/$defs/codedDimension" },
    "intended_audience": { "$ref": "#/$defs/codedDimension" },
    "application_setting": { "$ref": "#/$defs/codedDimension" },
    "interactive_narrative_form": { "$ref": "#/$defs/codedDimension" },
    "if_mechanics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "interaction_education_relationship": { "$ref": "#/$defs/codedDimension" },
    "design_pattern": { "type": "string", "minLength": 1 },
    "applicability_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "transferable_design_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["low", "medium", "high"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "knowledge_type": { "const": "domain_synthesis" } },
        "required": ["knowledge_type"]
      },
      "then": {
        "required": [
          "dimension",
          "summary",
          "total_n",
          "eligible_n",
          "not_stated_n",
          "uncertain_n",
          "label_counts",
          "status_counts",
          "related_pattern_ids",
          "related_design_card_ids"
        ]
      }
    },
    {
      "if": {
        "properties": { "knowledge_type": { "const": "cross_case_pattern" } },
        "required": ["knowledge_type"]
      },
      "then": {
        "required": [
          "pattern_kind",
          "dimensions",
          "labels",
          "total_n",
          "eligible_n",
          "support_n",
          "not_stated_n",
          "uncertain_n",
          "supporting_case_ids",
          "calculation_rule",
          "pattern_summary",
          "related_design_card_ids"
        ]
      }
    },
    {
      "if": {
        "properties": { "knowledge_type": { "const": "case_design_card" } },
        "required": ["knowledge_type"]
      },
      "then": {
        "required": [
          "annotation_ids",
          "quality_tier",
          "coverage_profile",
          "educational_purpose",
          "intended_audience",
          "application_setting",
          "interactive_narrative_form",
          "if_mechanics",
          "interaction_education_relationship",
          "design_pattern",
          "applicability_conditions",
          "transferable_design_questions",
          "confidence"
        ]
      }
    }
  ],
  "$defs": {
    "codedDimension": {
      "type": "object",
      "required": ["status", "labels", "summary"],
      "properties": {
        "status": { "enum": ["explicit", "normalized", "not_stated", "uncertain"] },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
