{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/corpus/schemas/knowledge-card.schema.json",
  "title": "Educational Interactive Narrative Knowledge Card",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_id",
    "knowledge_type",
    "quality_tier",
    "source_ids",
    "annotation_ids",
    "educational_purpose",
    "intended_audience",
    "application_setting",
    "interactive_narrative_form",
    "interaction_education_relationship",
    "design_pattern",
    "applicability_conditions",
    "transferable_design_questions",
    "limitations",
    "confidence",
    "retrieval_text",
    "model_facing"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-card/v1"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "knowledge_type": {
      "enum": ["case_precedent", "cross_case_pattern"]
    },
    "quality_tier": {
      "enum": ["A", "B", "C"]
    },
    "coverage_profile": {
      "enum": ["complete_core", "partial_substantive"]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "annotation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "educational_purpose": {
      "$ref": "#/$defs/codedDimension"
    },
    "intended_audience": {
      "$ref": "#/$defs/codedDimension"
    },
    "application_setting": {
      "$ref": "#/$defs/codedDimension"
    },
    "interactive_narrative_form": {
      "$ref": "#/$defs/codedDimension"
    },
    "interaction_education_relationship": {
      "$ref": "#/$defs/codedDimension"
    },
    "if_mechanics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "design_pattern": {
      "type": "string",
      "minLength": 1
    },
    "applicability_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transferable_design_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "retrieval_text": {
      "type": "string",
      "minLength": 1
    },
    "model_facing": {
      "const": true
    }
  },
  "$defs": {
    "codedDimension": {
      "type": "object",
      "required": ["status", "labels", "summary"],
      "properties": {
        "status": {
          "enum": ["explicit", "normalized", "not_stated", "uncertain"]
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
