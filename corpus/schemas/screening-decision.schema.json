{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/corpus/schemas/screening-decision.schema.json",
  "title": "Educational IF Screening Decision",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "review_status",
    "language",
    "information_coverage",
    "quality_tier",
    "exclusion_reasons",
    "reviewer_id",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "screening-decision/v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "review_status": {
      "enum": ["included", "excluded", "uncertain"]
    },
    "language": {
      "type": "object",
      "required": ["value", "method", "reviewed"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "platform_metadata",
            "local_detection",
            "reviewer",
            "combined"
          ]
        },
        "reviewed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "information_coverage": {
      "type": "object",
      "required": [
        "educational_purpose",
        "intended_audience",
        "application_setting",
        "interactive_narrative_form",
        "interaction_education_relationship"
      ],
      "properties": {
        "educational_purpose": {
          "$ref": "#/$defs/coverageStatus"
        },
        "intended_audience": {
          "$ref": "#/$defs/coverageStatus"
        },
        "application_setting": {
          "$ref": "#/$defs/coverageStatus"
        },
        "interactive_narrative_form": {
          "$ref": "#/$defs/coverageStatus"
        },
        "interaction_education_relationship": {
          "$ref": "#/$defs/coverageStatus"
        }
      },
      "additionalProperties": false
    },
    "quality_tier": {
      "enum": ["A", "B", "C", "unassigned"]
    },
    "coverage_profile": {
      "enum": [
        "complete_core",
        "partial_substantive",
        "form_only",
        "outside_scope_or_unresolved"
      ]
    },
    "exclusion_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "coverageStatus": {
      "enum": ["explicit", "interpreted", "not_stated", "uncertain"]
    }
  },
  "additionalProperties": false
}
