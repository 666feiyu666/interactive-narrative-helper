{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/narrative-technique-design-partner/techniques/counterfactual/schemas/counterfactual-case.schema.json",
  "title": "Counterfactual Narrative Case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "title",
    "source",
    "target_audience",
    "canonical_action",
    "counterfactual_question",
    "invariants",
    "mutable_assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "counterfactual-case/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["work", "tradition", "provenance", "rights_status"],
      "properties": {
        "work": {"type": "string", "minLength": 1},
        "tradition": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "rights_status": {
          "enum": [
            "public_domain",
            "licensed",
            "permission_required",
            "unknown"
          ]
        },
        "rights_notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target_audience": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["confirmed", "provisional", "to_be_confirmed"]},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "canonical_action": {
      "type": "object",
      "required": ["actor", "goal", "action", "canonical_consequence"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "canonical_consequence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "counterfactual_question": {
      "type": "string",
      "minLength": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mutable_assumptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "output_request": {
      "type": "object",
      "properties": {
        "action_count": {"type": ["integer", "null"], "minimum": 1},
        "additional_constraints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
