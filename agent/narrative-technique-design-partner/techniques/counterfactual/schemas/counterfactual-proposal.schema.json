{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/narrative-technique-design-partner/techniques/counterfactual/schemas/counterfactual-proposal.schema.json",
  "title": "Counterfactual Narrative Proposal",
  "type": "object",
  "required": ["schema_version", "case_id", "alternatives"],
  "properties": {
    "schema_version": {
      "const": "counterfactual-proposal/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "alternative_id",
          "action",
          "motivation",
          "source_compatibility",
          "consequence_projection",
          "meaning_projection",
          "required_source_changes",
          "assumptions",
          "risks"
        ],
        "properties": {
          "alternative_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "action": {"type": "string", "minLength": 1},
          "motivation": {"type": "string", "minLength": 1},
          "source_compatibility": {
            "type": "object",
            "required": ["preserved_invariants", "tensions"],
            "properties": {
              "preserved_invariants": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "tensions": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "consequence_projection": {
            "type": "object",
            "required": [
              "immediate",
              "intermediate",
              "new_conflict",
              "further_choices",
              "possible_endings"
            ],
            "properties": {
              "immediate": {"type": "string", "minLength": 1},
              "intermediate": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "new_conflict": {"type": "string", "minLength": 1},
              "further_choices": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "possible_endings": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "meaning_projection": {
            "type": "object",
            "required": ["thematic_shifts", "educational_implications"],
            "properties": {
              "thematic_shifts": {
                "type": "array",
                "items": {"$ref": "#/$defs/supportedInterpretation"}
              },
              "educational_implications": {
                "type": "array",
                "items": {"$ref": "#/$defs/supportedInterpretation"}
              }
            },
            "additionalProperties": false
          },
          "required_source_changes": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "assumptions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "risks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "supportedInterpretation": {
      "type": "object",
      "required": ["interpretation", "narrative_evidence"],
      "properties": {
        "interpretation": {"type": "string", "minLength": 1},
        "narrative_evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
