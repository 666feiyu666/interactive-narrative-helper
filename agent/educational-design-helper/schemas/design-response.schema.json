{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/educational-design-helper/schemas/design-response.schema.json",
  "title": "Educational Interactive Narrative Design Response",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "knowledge_snapshot_id",
    "evidence_status",
    "evidence_status_basis",
    "request_interpretation",
    "design_directions",
    "limitations",
    "follow_up_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "educational-design-response/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "knowledge_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "evidence_status": {
      "enum": [
        "sufficient_direct",
        "sufficient_analogical",
        "limited",
        "insufficient"
      ]
    },
    "evidence_status_basis": {
      "type": "object",
      "required": ["assessment_source", "rationale"],
      "properties": {
        "assessment_source": {
          "const": "generation_model"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "request_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "design_directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/designDirection"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "follow_up_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "designDimension": {
      "type": "object",
      "required": ["value", "basis"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user_request",
              "knowledge_precedent",
              "agent_adaptation",
              "agent_proposal",
              "open_question"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "knowledgeSupport": {
      "type": "object",
      "required": ["knowledge_id", "match_kind", "assessment_source", "use"],
      "properties": {
        "knowledge_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "match_kind": {
          "enum": ["direct", "partial", "analogical"]
        },
        "assessment_source": {
          "const": "generation_model"
        },
        "use": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "designDirection": {
      "type": "object",
      "required": [
        "direction_id",
        "title",
        "concept",
        "design_dimensions",
        "interaction_mechanism",
        "educational_relationship",
        "knowledge_support",
        "applicability_conditions",
        "transfer_assumptions",
        "risks"
      ],
      "properties": {
        "direction_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "design_dimensions": {
          "type": "object",
          "required": [
            "educational_purpose",
            "intended_audience",
            "application_setting",
            "interactive_narrative_form",
            "interaction_education_relationship"
          ],
          "properties": {
            "educational_purpose": {
              "$ref": "#/$defs/designDimension"
            },
            "intended_audience": {
              "$ref": "#/$defs/designDimension"
            },
            "application_setting": {
              "$ref": "#/$defs/designDimension"
            },
            "interactive_narrative_form": {
              "$ref": "#/$defs/designDimension"
            },
            "interaction_education_relationship": {
              "$ref": "#/$defs/designDimension"
            }
          },
          "additionalProperties": false
        },
        "interaction_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "educational_relationship": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/knowledgeSupport"
          }
        },
        "applicability_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transfer_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
