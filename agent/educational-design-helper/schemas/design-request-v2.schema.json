{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/educational-design-helper/schemas/design-request-v2.schema.json",
  "title": "Educational Interactive Narrative Design Request v2",
  "type": "object",
  "required": ["schema_version", "output_version", "request_id", "raw_question"],
  "properties": {
    "schema_version": { "const": "educational-design-request/v2" },
    "output_version": { "const": "0.2" },
    "request_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "raw_question": { "type": "string", "minLength": 1, "maxLength": 4000 }
  },
  "additionalProperties": false
}
