{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/educational-design-helper/schemas/design-response-v2.schema.json",
  "title": "Educational Interactive Narrative Design Response v2",
  "type": "object",
  "required": [
    "schema_version",
    "output_version",
    "request_id",
    "diagnosis",
    "directions",
    "reference_selections",
    "references",
    "recommended_next_step",
    "follow_up_question"
  ],
  "properties": {
    "schema_version": { "const": "educational-design-response/v2" },
    "output_version": { "const": "0.2" },
    "request_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "diagnosis": { "$ref": "#/$defs/diagnosis" },
    "directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/direction" }
    },
    "reference_selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/referenceSelection" }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/resolvedReference" }
    },
    "recommended_next_step": { "$ref": "#/$defs/adviceText" },
    "follow_up_question": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 2, "maxLength": 240, "pattern": "[？?]$" }
      ]
    }
  },
  "$defs": {
    "adviceText": { "type": "string", "minLength": 2, "maxLength": 500 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 160 },
    "dimensionName": {
      "enum": [
        "educational_purpose",
        "intended_audience",
        "application_setting",
        "interactive_narrative_form",
        "if_mechanics",
        "interaction_education_relationship"
      ]
    },
    "diagnosis": {
      "type": "object",
      "required": ["concept_summary", "confirmed_elements", "design_decisions"],
      "properties": {
        "concept_summary": { "$ref": "#/$defs/adviceText" },
        "confirmed_elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/shortText" }
        },
        "design_decisions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["decision", "why_it_matters", "options"],
            "properties": {
              "decision": { "$ref": "#/$defs/shortText" },
              "why_it_matters": { "$ref": "#/$defs/adviceText" },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/shortText" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "directionId": { "enum": ["direction_1", "direction_2", "direction_3"] },
    "direction": {
      "type": "object",
      "required": [
        "direction_id",
        "title",
        "best_fit",
        "design_goal",
        "core_interaction",
        "system_role",
        "key_tradeoff",
        "prototype_step"
      ],
      "properties": {
        "direction_id": { "$ref": "#/$defs/directionId" },
        "title": { "type": "string", "minLength": 2, "maxLength": 80 },
        "best_fit": { "$ref": "#/$defs/adviceText" },
        "design_goal": { "$ref": "#/$defs/adviceText" },
        "core_interaction": { "$ref": "#/$defs/adviceText" },
        "system_role": { "$ref": "#/$defs/adviceText" },
        "key_tradeoff": { "$ref": "#/$defs/adviceText" },
        "prototype_step": { "$ref": "#/$defs/adviceText" }
      },
      "additionalProperties": false
    },
    "referenceSelection": {
      "type": "object",
      "required": ["knowledge_id", "direction_ids", "why_relevant", "inspect_for"],
      "properties": {
        "knowledge_id": { "type": "string", "pattern": "^kc-[a-z0-9_-]+$" },
        "direction_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/directionId" }
        },
        "why_relevant": { "$ref": "#/$defs/adviceText" },
        "inspect_for": { "$ref": "#/$defs/adviceText" }
      },
      "additionalProperties": false
    },
    "resolvedReference": {
      "type": "object",
      "required": [
        "knowledge_id",
        "direction_ids",
        "why_relevant",
        "inspect_for",
        "project_id",
        "display_title",
        "platform",
        "public_url",
        "known_dimensions",
        "missing_dimensions"
      ],
      "properties": {
        "knowledge_id": { "type": "string", "pattern": "^kc-[a-z0-9_-]+$" },
        "direction_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/directionId" }
        },
        "why_relevant": { "$ref": "#/$defs/adviceText" },
        "inspect_for": { "$ref": "#/$defs/adviceText" },
        "project_id": { "type": "string", "pattern": "^itchio-[0-9]{4}$" },
        "display_title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "platform": { "const": "itch.io" },
        "public_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "known_dimensions": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimensionName" }
        },
        "missing_dimensions": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dimensionName" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
