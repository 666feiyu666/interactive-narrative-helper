{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/educational-design-helper/schemas/run-trace.schema.json",
  "title": "Educational Design Helper Run Trace",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "completed_at",
    "status",
    "failure_stage",
    "request_id",
    "knowledge_snapshot_id",
    "embedding_index",
    "retrieval_execution",
    "retrieval",
    "model_calls",
    "validation",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "educational-design-run-trace/v1" },
    "run_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["running", "succeeded", "failed"] },
    "failure_stage": {
      "type": ["string", "null"],
      "enum": [
        null,
        "input_validation",
        "retrieval",
        "generation",
        "response_validation",
        "trace_persistence"
      ]
    },
    "request_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "knowledge_snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "embedding_index": {
      "type": "object",
      "required": [
        "schema_version",
        "provider",
        "model",
        "dimensions",
        "knowledge_cards_sha256",
        "index_sha256"
      ],
      "properties": {
        "schema_version": { "const": "track-a-embedding-index/v1" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 },
        "knowledge_cards_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "retrieval_execution": {
      "type": "object",
      "required": [
        "method",
        "provider",
        "model",
        "query_sha256",
        "latency_ms",
        "usage"
      ],
      "properties": {
        "method": { "const": "embedding-cosine-top-k/v1" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "query_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "knowledge_id", "score"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "knowledge_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "score": { "type": "number", "minimum": -1, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "model_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "provider",
          "model",
          "prompt_version",
          "model_facing_knowledge_ids",
          "attempt",
          "request_sha256",
          "response_sha256",
          "latency_ms",
          "usage",
          "error_category"
        ],
        "properties": {
          "stage": { "enum": ["design_advisor", "repair"] },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "prompt_version": { "type": "string", "minLength": 1 },
          "model_facing_knowledge_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
          "request_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "response_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "latency_ms": { "type": "integer", "minimum": 0 },
          "usage": { "$ref": "#/$defs/usage" },
          "error_category": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": { "enum": ["not_run", "passed", "failed"] },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "required": ["category", "message"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "usage": {
      "type": ["object", "null"],
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
