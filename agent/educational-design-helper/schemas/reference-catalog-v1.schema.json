{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/agent/educational-design-helper/schemas/reference-catalog-v1.schema.json",
  "title": "Track A Public Reference Catalog v1",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_release_id",
    "source_workbook",
    "source_sha256",
    "reference_count",
    "references"
  ],
  "properties": {
    "schema_version": { "const": "track-a-reference-catalog/v1" },
    "knowledge_release_id": { "const": "track-a-educational-design-knowledge-v1" },
    "source_workbook": {
      "const": "outputs/itchio-sheet/itchio-educational-if-candidates-v1.0.xlsx"
    },
    "source_sha256": {
      "type": "object",
      "required": ["workbook", "coding_annotations", "design_cards"],
      "properties": {
        "workbook": { "$ref": "#/$defs/sha256" },
        "coding_annotations": { "$ref": "#/$defs/sha256" },
        "design_cards": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "reference_count": { "type": "integer", "minimum": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "knowledge_id",
          "project_id",
          "display_title",
          "platform",
          "public_url",
          "known_dimensions",
          "missing_dimensions"
        ],
        "properties": {
          "knowledge_id": { "type": "string", "pattern": "^kc-[a-z0-9_-]+$" },
          "project_id": { "type": "string", "pattern": "^itchio-[0-9]{4}$" },
          "display_title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "platform": { "const": "itch.io" },
          "public_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "known_dimensions": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dimensionName" }
          },
          "missing_dimensions": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dimensionName" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dimensionName": {
      "enum": [
        "educational_purpose",
        "intended_audience",
        "application_setting",
        "interactive_narrative_form",
        "if_mechanics",
        "interaction_education_relationship"
      ]
    }
  },
  "additionalProperties": false
}
