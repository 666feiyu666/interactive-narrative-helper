# Required. Keep the real key only in the ignored .env file.
OPENAI_API_KEY=

# OpenAI model used to generate the structured design response.
OPENAI_GENERATION_MODEL=gpt-5.6-luna

# OpenAI model used to embed display records and user queries.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional. Persist local display traces below the repository outputs directory.
SAVE_RUNS=0
