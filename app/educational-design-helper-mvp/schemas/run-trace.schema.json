{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/app/educational-design-helper-mvp/schemas/run-trace.schema.json",
  "title": "Educational Design Helper MVP Run Trace",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "completed_at",
    "status",
    "failure_stage",
    "request_id",
    "raw_question",
    "request_sha256",
    "demo_data_manifest_sha256",
    "demo_data_sha256",
    "embedding_indexes",
    "retrieval_execution",
    "retrieval",
    "model_calls",
    "validation",
    "error"
  ],
  "properties": {
    "schema_version": { "const": "educational-design-mvp-run" },
    "run_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["running", "succeeded", "failed"] },
    "failure_stage": {
      "type": ["string", "null"],
      "enum": [null, "retrieval", "generation", "response_validation"]
    },
    "request_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "raw_question": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "demo_data_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "demo_data_sha256": { "$ref": "#/$defs/sha256" },
    "embedding_indexes": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/embeddingIndex" }
    },
    "retrieval_execution": { "$ref": "#/$defs/retrievalExecution" },
    "retrieval": {
      "type": "object",
      "required": ["domain_summaries", "pattern_examples", "case_examples"],
      "properties": {
        "domain_summaries": { "type": "array", "items": { "$ref": "#/$defs/retrievalRecord" } },
        "pattern_examples": { "type": "array", "items": { "$ref": "#/$defs/retrievalRecord" } },
        "case_examples": { "type": "array", "items": { "$ref": "#/$defs/retrievalRecord" } }
      },
      "additionalProperties": false
    },
    "model_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "provider",
          "model",
          "prompt_id",
          "supplied_demo_item_ids",
          "selected_case_ids",
          "attempt",
          "request_sha256",
          "response_sha256",
          "latency_ms",
          "usage",
          "error_category"
        ],
        "properties": {
          "stage": { "enum": ["design_advisor", "repair"] },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "prompt_id": { "const": "design-advisor" },
          "supplied_demo_item_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
          },
          "selected_case_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^kc-[a-z0-9_-]+$" }
          },
          "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
          "request_sha256": { "$ref": "#/$defs/sha256" },
          "response_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "latency_ms": { "type": "integer", "minimum": 0 },
          "usage": { "$ref": "#/$defs/usage" },
          "error_category": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "errors",
        "body_character_count",
        "design_decision_count",
        "direction_count",
        "distinct_direction_count",
        "reference_selection_count",
        "internal_language_absent",
        "repair_attempts"
      ],
      "properties": {
        "status": { "enum": ["not_run", "passed", "failed"] },
        "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "body_character_count": { "type": ["integer", "null"], "minimum": 0 },
        "design_decision_count": { "type": "integer", "minimum": 0 },
        "direction_count": { "type": "integer", "minimum": 0 },
        "distinct_direction_count": { "type": "integer", "minimum": 0 },
        "reference_selection_count": { "type": "integer", "minimum": 0 },
        "internal_language_absent": { "type": "boolean" },
        "repair_attempts": { "type": "integer", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "required": ["category", "message"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "usage": {
      "type": ["object", "null"],
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "embeddingIndex": {
      "type": "object",
      "required": ["item_type", "provider", "model", "dimensions", "demo_file_sha256", "index_sha256"],
      "properties": {
        "item_type": { "enum": ["cross_case_pattern", "case_design_card"] },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 },
        "demo_file_sha256": { "$ref": "#/$defs/sha256" },
        "index_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "retrievalExecution": {
      "type": "object",
      "required": ["method", "provider", "model", "query_sha256", "latency_ms", "usage"],
      "properties": {
        "method": { "const": "demo-embedding-cosine-candidate-pool" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "query_sha256": { "$ref": "#/$defs/sha256" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "usage": { "$ref": "#/$defs/usage" }
      },
      "additionalProperties": false
    },
    "retrievalRecord": {
      "type": "object",
      "required": ["rank", "knowledge_id", "score"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "knowledge_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "score": { "type": ["number", "null"], "minimum": -1, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
