{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/app/educational-design-helper-mvp/schemas/demo-data.schema.json",
  "title": "Educational Design Helper MVP Demo Data",
  "type": "object",
  "required": ["purpose", "research_status", "source_status", "files", "aggregate_sha256", "limitations"],
  "properties": {
    "purpose": { "const": "display_only" },
    "research_status": { "const": "not_validated" },
    "source_status": { "const": "legacy_generated_derivative" },
    "files": {
      "type": "object",
      "required": ["domain_summaries", "pattern_examples", "case_examples"],
      "properties": {
        "domain_summaries": { "$ref": "#/$defs/fileRecord" },
        "pattern_examples": { "$ref": "#/$defs/fileRecord" },
        "case_examples": { "$ref": "#/$defs/fileRecord" }
      },
      "additionalProperties": false
    },
    "aggregate_sha256": { "$ref": "#/$defs/sha256" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileRecord": {
      "type": "object",
      "required": ["path", "count", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.ndjson$" },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
