{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/666feiyu666/interactive-narrative-helper/app/educational-design-helper-mvp/schemas/reference-catalog.schema.json",
  "title": "Educational Design Helper MVP Reference Catalog",
  "type": "object",
  "required": [
    "purpose",
    "source_status",
    "reference_count",
    "references"
  ],
  "properties": {
    "purpose": { "const": "display_only" },
    "source_status": { "const": "legacy_generated_derivative" },
    "reference_count": { "type": "integer", "minimum": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "knowledge_id",
          "project_id",
          "display_title",
          "platform",
          "public_url",
          "known_dimensions",
          "missing_dimensions"
        ],
        "properties": {
          "knowledge_id": { "type": "string", "pattern": "^kc-[a-z0-9_-]+$" },
          "project_id": { "type": "string", "pattern": "^itchio-[0-9]{4}$" },
          "display_title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "platform": { "const": "itch.io" },
          "public_url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "known_dimensions": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dimensionName" }
          },
          "missing_dimensions": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/dimensionName" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "dimensionName": {
      "enum": [
        "educational_purpose",
        "intended_audience",
        "application_setting",
        "interactive_narrative_form",
        "if_mechanics",
        "interaction_education_relationship"
      ]
    }
  },
  "additionalProperties": false
}
